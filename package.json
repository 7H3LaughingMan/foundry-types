{
    "name": "@7h3laughingman/foundry-types",
    "version": "14.360.9",
    "description": "Basic TypeScript types for FoundryVTT.",
    "homepage": "https://github.com/7H3LaughingMan/foundry-types#readme",
    "bugs": {
        "url": "https://github.com/7H3LaughingMan/foundry-types/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/7H3LaughingMan/foundry-types.git"
    },
    "license": "MIT",
    "author": "7H3LaughingMan <7H3LaughingMan@proton.me> (https://github.com/7H3LaughingMan)",
    "funding": "https://ko-fi.com/7h3laughingman",
    "type": "module",
    "imports": {
        "#client/*": "./src/client/*",
        "#common/*": "./src/common/*"
    },
    "types": "./src/index.d.ts",
    "exports": {
        ".": "./src/index.d.ts",
        "./client/*": "./src/client/*",
        "./common/*": "./src/common/*",
        "./global-external": "./src/global-external.d.mts"
    },
    "files": [
        "./src/*"
    ],
    "scripts": {
        "eslint:fix": "eslint src --fix && prettier src --write",
        "eslint": "eslint src",
        "prepare": "husky",
        "tsc": "tsc",
        "update": "pnpm dlx git-ripper https://github.com/foundryvtt/pf2e/tree/v14-dev/types/foundry -o ./build/src && node ./build/update.ts && eslint src --fix && prettier src --write"
    },
    "lint-staged": {
        "*.{ts,mts,cts,tsc,js,mjs,cjs,jsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@pixi/graphics-smooth": "^1.1.1",
        "@pixi/particle-emitter": "^5.0.10",
        "@types/jquery": "^3.5.34",
        "@types/simple-peer": "^9.11.9",
        "@types/ws": "^8.18.1",
        "codemirror": "^6.0.2",
        "gsap": "3.11.0",
        "handlebars": "^4.7.9",
        "jquery": "^3.7.1",
        "js-angusj-clipper": "^1.3.1",
        "peggy": "^5.1.0",
        "pixi.js": "^7.4.3",
        "prosemirror-collab": "^1.3.1",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-dropcursor": "^1.8.2",
        "prosemirror-gapcursor": "^1.4.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.4",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.0",
        "prosemirror-view": "^1.41.8",
        "showdown": "^2.1.0",
        "simple-peer": "^9.11.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
